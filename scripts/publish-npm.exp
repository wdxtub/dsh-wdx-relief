#!/usr/bin/expect -f
# Publish dsh-wdx-relief through npm's browser 2FA flow.
# NPM_PKG and NPM_VERSION are exported by scripts/publish-npm.sh.
# Usage: NPM_PKG=dsh-wdx-relief NPM_VERSION=0.4.0 expect scripts/publish-npm.exp
set timeout 600
set pkg $env(NPM_PKG)
set version $env(NPM_VERSION)
set root [file normalize [file join [file dirname [info script]] ..]]
cd $root
log_user 1
spawn npm publish --access public --registry=https://registry.npmjs.org/
set published 0
set failed 0
expect {
  "Press ENTER to open in the browser" {
    send "\r"
    puts "\nAUTH_BROWSER_OPENED"
    exp_continue
  }
  "+ $pkg@$version" {
    set published 1
    puts "\nPUBLISH_DONE"
    exp_continue
  }
  "Published" {
    set published 1
    puts "\nPUBLISH_DONE"
    exp_continue
  }
  "npm error" {
    set failed 1
    puts "\nPUBLISH_ERROR"
    exp_continue
  }
  eof {}
  timeout { puts "\nTIMEOUT" }
}
catch wait result
set code [lindex $result 3]
if {$published && !$failed} { exit 0 }
exit 1